---
import '../styles/global.css';
import { getCollection } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "L'Unione Stampa",
  description = 'La rivoluzione del giornale. L\'Unione Stampa e la Piuma.',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const home = base;
const asset = (path: string) => `${base}${path.replace(/^\//, '')}`;
const searchableArticles = await getCollection('articoli', ({ data }) => data.publishedAt <= new Date());
const relazioneArticle = searchableArticles.find((article) => article.id.includes('come-scrivere-il-futuro-essendo-presenti'));
const piumaArticle = searchableArticles.find((article) => article.id.startsWith('la-piuma'));
const relazioneHref = relazioneArticle ? `${base}articoli/${relazioneArticle.id}/` : `${base}articoli/come-scrivere-il-futuro-essendo-presenti.md/`;
const piumaHref = piumaArticle ? `${base}articoli/${piumaArticle.id}/` : `${base}articoli/la-piuma.md/`;
const searchEntries = [
  { title: 'Home', description: "La pagina principale de L'Unione Stampa", href: home, keywords: 'inizio homepage principale casa' },
  { title: 'Manifesti', description: 'Tutti i manifesti, le relazioni e le pubblicazioni editoriali', href: `${base}manifesti/`, keywords: 'manifesto manifesti relazione articolo libro pubblicazioni' },
  { title: 'La Piuma', description: "Il giornale pieghevole che si apre nel palmo di una mano", href: piumaHref, keywords: 'piuma piu giornale formato pieghevole manifesto articolo sui manifesti' },
  { title: 'Luoghi di rilascio', description: 'Dove trovare fisicamente le Piume', href: `${home}#luoghi`, keywords: 'luoghi rilascio distribuzione mappa punti dove trovare' },
  { title: 'Aggiornamenti', description: 'Novità tecniche, correzioni e sviluppo del sito', href: `${base}aggiornamenti/`, keywords: 'novita aggiornamenti sviluppo sito modifiche' },
  { title: 'Social', description: 'I canali social di Unione Stampa', href: `${home}#social`, keywords: 'instagram social seguici' },
  { title: 'Contatti', description: 'Scrivi alla redazione per collaborazioni e proposte', href: `${home}#contatti`, keywords: 'email contattare redazione collaborazione' },
  ...searchableArticles.map((article) => ({
    title: article.data.title,
    description: article.data.excerpt,
    href: `${base}articoli/${article.id}/`,
    keywords: `${article.data.category} ${article.id} ${article.data.issue ?? ''} ${article.data.title === 'Come scrivere il futuro essendo presenti' ? 'relazione socio-politica libro prima stampa manifesto manifesti' : ''}`,
  })),
];
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#b82626" />
    <link rel="icon" type="image/png" href={asset('assets/logo-symbol-original.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Lato:wght@300;400;700;900&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenuto">Vai al contenuto</a>

    <p class="site-disclaimer">Sito in fase di sviluppo · Alcune sezioni possono essere aggiornate.</p>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={home} aria-label="L'Unione Stampa — home">
          <img class="brand-symbol" src={asset('assets/logo-symbol-original.png')} alt="" aria-hidden="true" />
          <span class="brand-name">L'UNIONE <em>STAMPA</em></span>
        </a>
        <nav aria-label="Navigazione principale">
          <a class="nav-icon-link" href={home} aria-label="Home" title="Home">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z" /></svg>
          </a>
          <a class="nav-primary" href={`${base}manifesti/`}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3.5h10a2 2 0 0 1 2 2v15H5v-15a2 2 0 0 1 2-2Z"/><path d="M8 7h8M8 11h8M8 15h6M3 6v15"/></svg>
            <span>Manifesti</span>
          </a>
          <a class="nav-icon-link nav-location" href={`${home}#luoghi`} aria-label="Luoghi di rilascio" title="Luoghi di rilascio">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><path d="m8.5 10.2 2.2 2.2 4.8-4.8"/></svg>
          </a>
          <div class="site-search" role="search">
            <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4.5 4.5"/></svg>
            <label class="sr-only" for="site-search-input">Cerca nel sito</label>
            <input id="site-search-input" type="search" placeholder="Cerca nel sito…" autocomplete="off" aria-controls="site-search-results" aria-expanded="false" />
            <div id="site-search-results" class="search-results" role="listbox" aria-label="Suggerimenti di ricerca" hidden></div>
          </div>
          <a class="nav-secondary nav-social" href={`${home}#social`}>Social</a>
          <a class="nav-secondary nav-contact" href={`${home}#contatti`}>Contatti</a>
        </nav>
      </div>
    </header>

    <main id="contenuto">
      <slot />
    </main>

    <aside class="novelty-dock is-collapsed"
      aria-label="Suggerimenti in evidenza"
      data-base={base}
      data-relation-image={asset('assets/copertina-come-scrivere-il-futuro.png')}
      data-piuma-image={asset('assets/logo-symbol.png')}
      data-piuma-href={piumaHref}
      data-relation-href={relazioneHref}
      data-updates-image={asset('assets/logo-wordmark.png')}>
      <button class="novelty-toggle" type="button" data-novelty-toggle aria-controls="novelty-panel-content" aria-expanded="false" aria-label="Apri i suggerimenti in evidenza">
        <span class="novelty-toggle-symbol" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M12 3.5 14.4 9.6 20.5 12l-6.1 2.4L12 20.5l-2.4-6.1L3.5 12l6.1-2.4Z"/><path d="m19 2 .9 2.1L22 5l-2.1.9L19 8l-.9-2.1L16 5l2.1-.9Z"/></svg>
        </span>
        <span class="novelty-toggle-copy">
          <strong>In evidenza</strong>
          <span data-novelty-toggle-hint>Novità e consigli della redazione</span>
        </span>
        <span class="novelty-notification" aria-label="Tre suggerimenti disponibili" data-novelty-count>3</span>
        <svg class="novelty-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </button>
      <div class="novelty-panel-content" id="novelty-panel-content" data-novelty-content>
        <span class="novelty-kicker"><i aria-hidden="true"></i> SCELTI PER TE</span>
        <a class="novelty-card" href={relazioneHref} data-novelty-link>
          <span class="novelty-index" data-novelty-index>01 / 03</span>
          <strong data-novelty-title>La prima relazione stampata</strong>
          <span data-novelty-copy>Come scrivere il futuro essendo presenti</span>
          <span class="novelty-cta">Scopri la novità <b aria-hidden="true">↗</b></span>
        </a>
        <div class="novelty-progress" aria-hidden="true"><span></span></div>
        <div class="novelty-dots" aria-label="Seleziona un suggerimento">
          <button type="button" aria-label="Suggerimento 1" aria-current="true" data-novelty-dot="0"></button>
          <button type="button" aria-label="Suggerimento 2" aria-current="false" data-novelty-dot="1"></button>
          <button type="button" aria-label="Suggerimento 3" aria-current="false" data-novelty-dot="2"></button>
        </div>
      </div>
    </aside>

    <footer class="site-footer">
      <div class="wrap footer-main">
        <div class="footer-brand-block">
          <img class="footer-wordmark" src={asset('assets/logo-wordmark.png')} alt="L'Unione Stampa" />
          <p>La rivoluzione del giornale.</p>
        </div>
        <div class="footer-org">
          <span>Organizzazione madre</span>
          <strong>Unione Sparvieri</strong>
          <p>politica e società</p>
        </div>
        <div class="footer-copy">
          <p>© {new Date().getFullYear()} L'Unione Stampa</p>
          <p>© {new Date().getFullYear()} Unione Sparvieri</p>
        </div>
      </div>
      <div class="wrap footer-bottom">
        <span>Editoriale gratuita · nessun abbonamento · nessuna vendita.</span>
        <div class="footer-bottom-links"><a href={`${base}aggiornamenti/`}>Aggiornamenti ↗</a><a href={`${base}#contatti`}>Contatti →</a></div>
      </div>
    </footer>
    <script define:vars={{ searchEntries }}>
      (() => {
        const input = document.getElementById('site-search-input');
        const results = document.getElementById('site-search-results');
        if (!input || !results) return;
        const normalize = (value) => String(value ?? '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
        const closeResults = () => { results.hidden = true; input.setAttribute('aria-expanded', 'false'); };
        const renderResults = () => {
          const query = normalize(input.value);
          results.replaceChildren();
          if (!query) { closeResults(); return; }
          const matches = searchEntries.map((entry, index) => {
            const title = normalize(entry.title);
            const description = normalize(entry.description);
            const keywords = normalize(entry.keywords);
            const full = `${title} ${description} ${keywords}`;
            let score = title.includes(query) ? (title.startsWith(query) ? 0 : 2) : keywords.includes(query) ? 3 : description.includes(query) ? 4 : -1;
            if (query.length >= 3 && full.split(/\s+/).some((word) => word.startsWith(query))) score = score < 0 ? 1 : Math.min(score, 1);
            return { entry, score, index };
          }).filter((item) => item.score >= 0)
            .sort((a, b) => a.score - b.score || a.index - b.index)
            .slice(0, 7);
          if (!matches.length) {
            const empty = document.createElement('p');
            empty.className = 'search-empty';
            empty.textContent = 'Nessun risultato. Prova un altro termine.';
            results.append(empty);
          } else {
            for (const { entry } of matches) {
              const a = document.createElement('a');
              a.className = 'search-result';
              a.setAttribute('role', 'option');
              a.href = entry.href;
              const title = document.createElement('strong');
              title.textContent = entry.title;
              const description = document.createElement('span');
              description.textContent = entry.description;
              a.append(title, description);
              results.append(a);
            }
          }
          results.hidden = false;
          input.setAttribute('aria-expanded', 'true');
        };
        input.addEventListener('input', renderResults);
        input.addEventListener('focus', () => { if (input.value.trim()) renderResults(); });
        input.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') { closeResults(); input.blur(); }
          if (event.key === 'ArrowDown' && !results.hidden) {
            const first = results.querySelector('a');
            if (first) { event.preventDefault(); first.focus(); }
          }
        });
        results.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') { closeResults(); input.focus(); }
        });
        document.addEventListener('click', (event) => {
          if (!event.target.closest('.site-search')) closeResults();
        });
      })();
    </script>

    <script is:inline>
      (() => {
        const dock = document.querySelector('.novelty-dock');
        if (!dock) return;
        const link = dock.querySelector('[data-novelty-link]');
        const toggle = dock.querySelector('[data-novelty-toggle]');
        const toggleHint = dock.querySelector('[data-novelty-toggle-hint]');
        // Riutilizza l'URL generato da Astro per la relazione, invece di
        // ricostruirlo a mano: così resta identico al link del Manifesto.
        const base = dock.dataset.base || '/UnioneStampa/';
        const relationHref = dock.dataset.relationHref || document.querySelector('[data-relation-link]')?.getAttribute('href') || link.getAttribute('href');
        const items = [
          { href: relationHref, title: 'La prima relazione stampata', copy: 'Come scrivere il futuro essendo presenti', image: dock.dataset.relationImage, tint: '#9d2725' },
          { href: dock.dataset.piumaHref || `${base}articoli/la-piuma.md/`, title: 'La Piuma', copy: 'Veloce e potente nel palmo di una mano', image: dock.dataset.piumaImage, tint: '#b82626' },
          { href: `${base}aggiornamenti/`, title: 'Novità del sito', copy: 'Aggiornamenti, funzioni e sviluppo del progetto', image: dock.dataset.updatesImage, tint: '#29231f' }
        ];
        const title = dock.querySelector('[data-novelty-title]');
        const copy = dock.querySelector('[data-novelty-copy]');
        const index = dock.querySelector('[data-novelty-index]');
        const progress = dock.querySelector('.novelty-progress span');
        const dots = [...dock.querySelectorAll('[data-novelty-dot]')];
        let current = 0;
        let timer;
        const isExpanded = () => !dock.classList.contains('is-collapsed');
        const stop = () => { if (timer) { window.clearInterval(timer); timer = undefined; } };
        const start = () => {
          stop();
          if (!isExpanded() || dock.matches(':hover') || dock.contains(document.activeElement) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          timer = window.setInterval(() => show((current + 1) % items.length), 7000);
        };
        const show = (n) => {
          current = (n + items.length) % items.length;
          const item = items[current];
          link.href = item.href;
          title.textContent = item.title;
          copy.textContent = item.copy;
          dock.style.setProperty('--novelty-image', `url("${item.image}")`);
          dock.style.setProperty('--novelty-tint', item.tint);
          index.textContent = `0${current + 1} / 0${items.length}`;
          dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === current)));
          progress.style.width = `${((current + 1) / items.length) * 100}%`;
          if (toggleHint) toggleHint.textContent = `${items.length} suggerimenti della redazione`;
        };
        const setExpanded = (expanded) => {
          dock.classList.toggle('is-collapsed', !expanded);
          toggle.setAttribute('aria-expanded', String(expanded));
          toggle.setAttribute('aria-label', expanded ? 'Chiudi i suggerimenti in evidenza' : 'Apri i suggerimenti in evidenza');
          if (expanded) dock.dataset.seen = 'true';
          if (expanded) start(); else stop();
        };
        toggle?.addEventListener('click', () => setExpanded(!isExpanded()));
        dots.forEach((dot) => dot.addEventListener('click', () => { show(Number(dot.dataset.noveltyDot)); start(); }));
        dock.addEventListener('mouseenter', stop);
        dock.addEventListener('mouseleave', start);
        dock.addEventListener('focusin', stop);
        dock.addEventListener('focusout', (event) => {
          if (!dock.contains(event.relatedTarget)) start();
        });
        show(0);
        setExpanded(false);
      })();
    </script>
  </body>
</html>
