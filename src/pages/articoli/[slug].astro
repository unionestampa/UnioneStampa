---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articoli');
  // Genera sempre la pagina per ogni articolo, anche se la data di pubblicazione
  // è futura: il filtro temporale resta nelle liste della homepage, non nelle route.
  const paths = new Map<string, { params: { slug: string }; props: { article: typeof articles[number] } }>();
  for (const article of articles.filter((entry) => entry.id !== 'modello' && entry.slug !== 'modello')) {
    const cleanId = article.id.replace(/\.md$/i, '');
    const candidates = new Set<string>([article.id, article.slug, cleanId, `${cleanId}.md`].filter((value): value is string => Boolean(value)));
    for (const slug of candidates) {
      paths.set(slug, { params: { slug }, props: { article } });
    }
  }
  return [...paths.values()];
}

const { article } = Astro.props;
const { Content } = await render(article);
const base = import.meta.env.BASE_URL;
const coverUrl = article.data.cover ? `${base}${article.data.cover.replace(/^\//, '')}` : null;
const relationSlug = 'come-scrivere-il-futuro-essendo-presenti';
const isRelation = article.id.replace(/\.md$/i, '') === relationSlug || article.slug.replace(/\.md$/i, '') === relationSlug;
const relationMockupUrl = `${base}images/pubblicazioni/mockup-libro-relazione-futuro.png`;
const backHref = article.data.category.toLowerCase() === 'manifesto' ? `${base}manifesti/` : base;
const backLabel = article.data.category.toLowerCase() === 'manifesto' ? 'Torna ai Manifesti' : "Torna a Unione Stampa";
const isPiuma = article.data.issue === 'La Piuma · OTT26';
const piumaIndexHref = `${base}piuma/ottobre-26/`;
const isPhotography = article.data.pageType === 'photography';
---
<Layout title={`${article.data.title} — L'Unione Stampa`} description={article.data.excerpt}>
  {isPiuma ? (
    <article class="piuma-article-page wrap">
      <a class="back-link" href={piumaIndexHref}>← Torna a Piuma - Ottobre 26</a>
      <header class="piuma-article-head">
        <div class="piuma-article-kicker"><img src={`${base}images/brand/logo-piuma-nero.png`} alt="" aria-hidden="true" /><span>LA PIUMA · OTT26</span><span class="piuma-article-category">{article.data.category}</span></div>
        {isPhotography ? (
          <>
            <h1>Fotografie del mese</h1>
            <p class="piuma-article-month">Ottobre 26</p>
            <p class="article-excerpt">{article.data.excerpt}</p>
            <section class="piuma-photo-gallery" data-photo-carousel aria-label="Podio fotografico di ottobre 2026">
              <div class="piuma-photo-podium" data-photo-track tabindex="0" aria-label="Scorri le fotografie classificate">
                <a class="piuma-photo-place piuma-photo-place--second piuma-photo-link" href="https://www.instagram.com/fiumesandcreek_/" rel="noopener noreferrer" aria-label="Apri il profilo Instagram di Giordano Luca, Fiumesandcreek_">
                  <div class="piuma-photo-image manifesti-card-placeholder">
                    <img src={`${base}images/pubblicazioni/foto-del-mese/ott26/giordano-luca-ott26.jpg`} alt="Fotografia di Giordano Luca, secondo classificato" loading="lazy" decoding="async" draggable="false" />
                  </div>
                  <strong class="piuma-photo-rank">2</strong>
                  <span class="piuma-photo-caption">Secondo posto</span>
                  <span class="piuma-photo-author">Giordano Luca</span>
                  <span class="piuma-photo-handle">Fiumesandcreek_</span>
                  <small class="piuma-photo-copyright">© Fiumesandcreek_ · Tutti i diritti riservati</small>
                </a>
                <a class="piuma-photo-place piuma-photo-place--first piuma-photo-link" href="https://www.instagram.com/pitt.bertelli/" rel="noopener noreferrer" aria-label="Apri il profilo Instagram di Pietro Bertelli, primo classificato">
                  <div class="piuma-photo-image manifesti-card-placeholder">
                    <img src={`${base}images/pubblicazioni/foto-del-mese/ott26/pietro-bertelli-ott26.jpg`} alt="Fotografia di Pietro Bertelli, primo classificato" loading="eager" decoding="async" draggable="false" />
                  </div>
                  <strong class="piuma-photo-rank">1</strong>
                  <span class="piuma-photo-caption">Primo posto</span>
                  <span class="piuma-photo-author">Pietro Bertelli</span>
                  <small class="piuma-photo-copyright">© Pietro Bertelli · Tutti i diritti riservati</small>
                </a>
                <a class="piuma-photo-place piuma-photo-place--third piuma-photo-link" href="https://www.instagram.com/andreacostantino22/" rel="noopener noreferrer" aria-label="Apri il profilo Instagram di Andrea Costantino, terzo classificato">
                  <div class="piuma-photo-image manifesti-card-placeholder">
                    <img src={`${base}images/pubblicazioni/foto-del-mese/ott26/andrea-costantino-ott26.jpg`} alt="Fotografia di Andrea Costantino, terzo classificato" loading="lazy" decoding="async" draggable="false" />
                  </div>
                  <strong class="piuma-photo-rank">3</strong>
                  <span class="piuma-photo-caption">Terzo posto</span>
                  <span class="piuma-photo-author">Andrea Costantino</span>
                  <small class="piuma-photo-copyright">© Andrea Costantino · Tutti i diritti riservati</small>
                </a>
              </div>
              <div class="piuma-photo-controls" aria-label="Controlli fotografie">
                <button type="button" data-photo-prev aria-label="Fotografia precedente">←</button>
                <span data-photo-position aria-live="polite">1° posto</span>
                <button type="button" data-photo-next aria-label="Fotografia successiva">→</button>
              </div>
            </section>
          </>
        ) : (
          <>
            <h1>{article.data.title}</h1>
            {article.data.subtitle && <p class="piuma-article-subtitle">{article.data.subtitle}</p>}
            <p class="article-excerpt">{article.data.excerpt}</p>
            <div class="piuma-article-meta"><span>{article.data.publishedAt.toLocaleDateString('it-IT')}</span><span>{article.data.readTime} di lettura</span>{article.data.byline && <span>{article.data.byline}</span>}</div>
          </>
        )}
      </header>
      <div class="article-body piuma-article-body">
        <Content />
      </div>
      <footer class="piuma-article-credit">© 2026 Unione Stampa · Unione Sparvieri <span>La Piuma · OTT26 · Realizzazione editoriale e grafica: Luca Barretta Lalić</span></footer>
    </article>
  ) : (
    <article class="article-page wrap">
      <header class="article-head">
        <a class="back-link" href={backHref}>← {backLabel}</a>
        <div class="featured-meta">
          <span>{article.data.category}</span>
          <time datetime={article.data.publishedAt.toISOString()}>{article.data.publishedAt.toLocaleDateString('it-IT')}</time>
          <span>{article.data.readTime}</span>
        </div>
        <h1>{article.data.title}</h1>
        <p class="article-excerpt">{article.data.excerpt}</p>
        {coverUrl && (
          <div class={isRelation ? 'book-feature book-feature--relation' : 'book-feature'}>
            <div class={isRelation ? 'book-mockup book-mockup--render' : 'book-mockup'} aria-label="Anteprima della relazione stampata">
              {isRelation ? (
                <img src={relationMockupUrl} alt="Mockup tridimensionale della relazione Come scrivere il futuro essendo presenti, con copertina rossa e avorio" />
              ) : (
                <>
                  <div class="book-spine" aria-hidden="true"></div>
                  <img src={coverUrl} alt={`Copertina di ${article.data.title}`} />
                  <div class="book-pages" aria-hidden="true"></div>
                </>
              )}
            </div>
            <div class={isRelation ? 'book-caption book-caption--relation' : 'book-caption'}>
              <span>PRIMA STAMPA DI PRODUZIONE</span>
              <strong>Una relazione di analisi socio-politica su giovani, società e potere decisionale, realizzata dall'Unione Sparvieri attraverso Unione Stampa.</strong>
              {isRelation && (
                <p class="book-distribution-note">La distribuzione è gestita direttamente. Per informazioni o per richiedere una copia, consulta la sezione <a href={`${base}#contatti`}>Contatti</a>.</p>
              )}
            </div>
          </div>
        )}
      </header>
      <div class="article-body"><Content /></div>
    </article>
  )}

<script is:inline>
  (() => {
    const gallery = document.querySelector('[data-photo-carousel]');
    if (!gallery) return;
    const track = gallery.querySelector('[data-photo-track]');
    const cards = [...track.querySelectorAll('.piuma-photo-place')];
    const previous = gallery.querySelector('[data-photo-prev]');
    const next = gallery.querySelector('[data-photo-next]');
    const position = gallery.querySelector('[data-photo-position]');
    const mobile = window.matchMedia('(max-width: 760px)');
    let active = 1;
    let raf = 0;

    const nearestIndex = () => {
      const trackRect = track.getBoundingClientRect();
      const center = track.clientWidth / 2;
      return cards.reduce((best, card, index) => {
        const cardRect = card.getBoundingClientRect();
        const cardCenter = cardRect.left - trackRect.left + cardRect.width / 2;
        const bestRect = cards[best].getBoundingClientRect();
        const bestCenter = bestRect.left - trackRect.left + bestRect.width / 2;
        return Math.abs(cardCenter - center) < Math.abs(bestCenter - center) ? index : best;
      }, 0);
    };
    const updateControls = () => {
      active = nearestIndex();
      position.textContent = `${cards[active].querySelector('.piuma-photo-rank')?.textContent ?? active + 1}° posto`;
      previous.disabled = active === 0;
      next.disabled = active === cards.length - 1;
    };
    const centerFirst = () => {
      if (!mobile.matches) return;
      const firstPlace = cards.find((card) => card.classList.contains('piuma-photo-place--first'));
      if (!firstPlace) return;
      const trackRect = track.getBoundingClientRect();
      const cardRect = firstPlace.getBoundingClientRect();
      track.scrollLeft += cardRect.left - trackRect.left - (track.clientWidth - cardRect.width) / 2;
      updateControls();
    };
    const move = (step) => {
      const target = Math.max(0, Math.min(cards.length - 1, nearestIndex() + step));
      const trackRect = track.getBoundingClientRect();
      const cardRect = cards[target].getBoundingClientRect();
      const nextLeft = track.scrollLeft + cardRect.left - trackRect.left - (track.clientWidth - cardRect.width) / 2;
      track.scrollTo({ left: nextLeft, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    };

    requestAnimationFrame(centerFirst);
    window.addEventListener('resize', centerFirst, { passive: true });
    track.addEventListener('scroll', () => {
      if (raf) cancelAnimationFrame(raf);
      raf = requestAnimationFrame(updateControls);
    }, { passive: true });
    previous.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));
    gallery.addEventListener('contextmenu', (event) => {
      if (event.target instanceof Element && event.target.closest('.piuma-photo-link')) event.preventDefault();
    });
    gallery.addEventListener('dragstart', (event) => {
      if (event.target instanceof Element && event.target.closest('.piuma-photo-link')) event.preventDefault();
    });
    gallery.addEventListener('auxclick', (event) => {
      if (event.target instanceof Element && event.target.closest('.piuma-photo-link')) event.preventDefault();
    });
    gallery.addEventListener('click', (event) => {
      if (!(event.target instanceof Element) || !event.target.closest('.piuma-photo-link')) return;
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) event.preventDefault();
    });
  })();
</script>

</Layout>
