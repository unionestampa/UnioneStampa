---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articoli');
  // Genera sempre la pagina per ogni articolo, anche se la data di pubblicazione
  // è futura: il filtro temporale resta nelle liste della homepage, non nelle route.
  return articles
    // Esclude esplicitamente la vecchia pagina-guida, anche se il contenuto dovesse ricomparire.
    .filter((article) => article.id !== 'modello' && article.slug !== 'modello')
    .map((article) => ({
      params: { slug: article.id },
      props: { article },
    }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const base = import.meta.env.BASE_URL;
const coverUrl = article.data.cover ? `${base}${article.data.cover.replace(/^\//, '')}` : null;
const relationSlug = 'come-scrivere-il-futuro-essendo-presenti';
const isRelation = article.id.replace(/\.md$/i, '') === relationSlug || article.slug.replace(/\.md$/i, '') === relationSlug;
const relationMockupUrl = `${base}images/pubblicazioni/mockup-libro-relazione-futuro.png`;
const backHref = article.data.category.toLowerCase() === 'manifesto' ? `${base}manifesti/` : base;
const backLabel = article.data.category.toLowerCase() === 'manifesto' ? 'Torna ai Manifesti' : "Torna a Unione Stampa";
---
<Layout title={`${article.data.title} — L'Unione Stampa`} description={article.data.excerpt}>
  <article class="article-page wrap">
    <header class="article-head">
      <a class="back-link" href={backHref}>← {backLabel}</a>
      <div class="featured-meta">
        <span>{article.data.category}</span>
        <time datetime={article.data.publishedAt.toISOString()}>{article.data.publishedAt.toLocaleDateString('it-IT')}</time>
        <span>{article.data.readTime}</span>
      </div>
      <h1>{article.data.title}</h1>
      <p class="article-excerpt">{article.data.excerpt}</p>
      {coverUrl && (
        <div class={isRelation ? 'book-feature book-feature--relation' : 'book-feature'}>
          <div class={isRelation ? 'book-mockup book-mockup--render' : 'book-mockup'} aria-label="Anteprima della relazione stampata">
            {isRelation ? (
              <img src={relationMockupUrl} alt="Mockup tridimensionale della relazione Come scrivere il futuro essendo presenti, con copertina rossa e avorio" />
            ) : (
              <>
                <div class="book-spine" aria-hidden="true"></div>
                <img src={coverUrl} alt={`Copertina di ${article.data.title}`} />
                <div class="book-pages" aria-hidden="true"></div>
              </>
            )}
          </div>
          <div class={isRelation ? 'book-caption book-caption--relation' : 'book-caption'}>
            <span>PRIMA STAMPA DI PRODUZIONE</span>
            <strong>Una relazione di analisi socio-politica su giovani, società e potere decisionale, realizzata dall'Unione Sparvieri attraverso Unione Stampa.</strong>
            {isRelation && (
              <p class="book-distribution-note">La distribuzione è gestita direttamente. Per informazioni o per richiedere una copia, consulta la sezione <a href={`${base}#contatti`}>Contatti</a>.</p>
            )}
          </div>
        </div>
      )}
    </header>
    <div class="article-body">
      <Content />
    </div>
  </article>
</Layout>
