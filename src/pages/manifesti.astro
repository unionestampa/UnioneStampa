---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const now = new Date();
const base = import.meta.env.BASE_URL;
const manifesti = (await getCollection('articoli', ({ data }) => data.publishedAt <= now && data.category.toLowerCase() === 'manifesto'))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const assetFor = (article) => article.data.cover
  ? `${base}${article.data.cover.replace(/^\//, '')}`
  : `${base}assets/logo-symbol.png`;
---

<Layout title="Manifesti — L'Unione Stampa" description="L'archivio dei manifesti, delle relazioni e delle pubblicazioni de L'Unione Stampa.">
  <section class="manifesti-hero">
    <div class="wrap">
      <a class="back-link back-link--light" href={base}>← Torna alla Home</a>
      <p class="eyebrow light">ARCHIVIO EDITORIALE</p>
      <h1>Manifesti.</h1>
      <p>Idee, analisi e pubblicazioni dell'Unione Stampa raccolte in un unico spazio.</p>
      <span class="manifesti-count">{String(manifesti.length).padStart(2, '0')} PUBBLICAZIONI DISPONIBILI</span>
    </div>
  </section>

  <section class="manifesti-archive wrap" aria-label="Tutti i manifesti">
    {manifesti.length > 0 ? (
      <div class="manifesti-grid">
        {manifesti.map((article, index) => (
          <a class="manifesti-card" href={`${base}articoli/${article.id}/`} style={`--manifesto-image: url("${assetFor(article)}")`}>
            <span class="manifesti-card-number">{String(index + 1).padStart(2, '0')} / {String(manifesti.length).padStart(2, '0')}</span>
            <span class="manifesti-card-content">
              <span class="manifesti-card-meta">{article.data.category} · {article.data.publishedAt.toLocaleDateString('it-IT')} · {article.data.readTime}</span>
              <strong>{article.data.title}</strong>
              <span class="manifesti-card-description">{article.data.excerpt}</span>
              <span class="manifesti-card-cta">Leggi la pubblicazione <b aria-hidden="true">↗</b></span>
            </span>
          </a>
        ))}
      </div>
    ) : (
      <p class="manifesti-empty">Le pubblicazioni saranno aggiunte qui.</p>
    )}
  </section>
</Layout>
