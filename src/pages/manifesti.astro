---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const now = new Date();
const base = import.meta.env.BASE_URL;
const pubblicazioni = (await getCollection('articoli', ({ data }) => data.publishedAt <= now))
  .filter((article) => article.id.includes('come-scrivere-il-futuro-essendo-presenti') || article.id.startsWith('la-piuma'))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
type Pubblicazione = (typeof pubblicazioni)[number];
const assetFor = (article: Pubblicazione): string => {
  if (article.data.cover) return `${base}${article.data.cover.replace(/^\//, '')}`;
  return `${base}images/manifesti/manifesto-la-piuma-copertina-home.png`;
};
const kindLabel = (article: Pubblicazione): string => article.data.kind === 'relazioni'
  ? 'Relazione'
  : article.data.category.toLowerCase() === 'manifesto'
    ? 'Manifesto'
    : article.data.kind === 'libri' ? 'Libro' : 'Articolo';
---

<Layout title="Tutti i manifesti · L'Unione Stampa" description="L'archivio di manifesti, relazioni, articoli e pubblicazioni de L'Unione Stampa.">
  <section class="manifesti-hero">
    <div class="wrap">
      <a class="back-link back-link--light" href={base}>← Torna alla Home</a>
      <p class="eyebrow light">ARCHIVIO EDITORIALE</p>
      <h1>Tutti i manifesti</h1>
      <p>Relazioni, articoli, libri e pubblicazioni dell'Unione Stampa, consultabili in un unico archivio.</p>
      <span class="manifesti-count" data-archive-count>{String(pubblicazioni.length).padStart(2, '0')} PUBBLICAZIONI DISPONIBILI</span>
    </div>
  </section>

  <section class="manifesti-archive wrap" aria-label="Archivio delle pubblicazioni">
    <form class="manifesti-filter-panel" data-archive-form role="search">
      <div class="manifesti-filter-layout">
        <div class="manifesti-search-column">
          <div class="manifesti-search-wrap">
            <label class="sr-only" for="manifesti-search">Cerca nell'archivio</label>
            <input id="manifesti-search" type="search" placeholder="Cerca per titolo, parola o argomento…" autocomplete="off" data-archive-search enterkeyhint="search" />
            <button class="manifesti-search-submit" type="submit" aria-label="Cerca nell'archivio" title="Cerca">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4.5 4.5"/></svg>
            </button>
          </div>
          <p class="manifesti-results-summary" data-archive-summary aria-live="polite">Mostro tutte le {pubblicazioni.length} pubblicazioni.</p>
        </div>

        <div class="manifesti-filter-selects">
          <details class="manifesti-filter-dropdown">
            <summary class="manifesti-filter-trigger">Tipo di pubblicazione <span data-kind-count></span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
            <div class="manifesti-filter-popover" role="group" aria-label="Tipo di pubblicazione">
              <button type="button" class="manifesti-filter-tag" data-archive-kind-tag="relazioni" aria-pressed="false">Relazioni</button>
              <button type="button" class="manifesti-filter-tag" data-archive-kind-tag="articoli" aria-pressed="false">Articoli</button>
              <button type="button" class="manifesti-filter-tag" data-archive-kind-tag="libri" aria-pressed="false">Libri</button>
            </div>
          </details>
          <details class="manifesti-filter-dropdown">
            <summary class="manifesti-filter-trigger">Temi <span data-theme-count></span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
            <div class="manifesti-filter-popover" role="group" aria-label="Temi">
              <button type="button" class="manifesti-filter-tag" data-archive-theme-tag="politica" aria-pressed="false">Politica</button>
              <button type="button" class="manifesti-filter-tag" data-archive-theme-tag="società" aria-pressed="false">Società</button>
              <button type="button" class="manifesti-filter-tag" data-archive-theme-tag="giovani" aria-pressed="false">Giovani</button>
              <button type="button" class="manifesti-filter-tag" data-archive-theme-tag="editoria" aria-pressed="false">Editoria</button>
              <button type="button" class="manifesti-filter-tag" data-archive-theme-tag="scuola" aria-pressed="false">Scuola</button>
              <button type="button" class="manifesti-filter-tag" data-archive-theme-tag="lavoro" aria-pressed="false">Lavoro</button>
              <button type="button" class="manifesti-filter-tag" data-archive-theme-tag="arte" aria-pressed="false">Arte</button>
            </div>
          </details>
          <button class="manifesti-filter-reset" type="button" data-archive-reset>Reset</button>
        </div>
      </div>
    </form>

    <div class="manifesti-grid manifesti-grid--archive" data-archive-grid>
      {pubblicazioni.map((article, index) => (
        <a class="manifesti-card" data-archive-card data-kind={article.data.kind} data-themes={article.data.themes.join(' ')} data-search-text={`${article.data.title} ${article.data.excerpt} ${article.data.category} ${article.data.kind} ${article.data.themes.join(' ')} ${article.body ?? ''}`} href={`${base}articoli/${article.id}/`} style={`--manifesto-image: url("${assetFor(article)}")`}>
          <span class="manifesto-new-badge manifesti-card-badge"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5 14.4 9.6 20.5 12l-6.1 2.4L12 20.5l-2.4-6.1L3.5 12l6.1-2.4Z"/><path d="m19 2 .9 2.1L22 5l-2.1.9L19 8l-.9-2.1L16 5l2.1-.9Z"/></svg><span>NOVITÀ</span></span>
          <span class="manifesti-card-number">{String(index + 1).padStart(2, '0')} / {String(pubblicazioni.length).padStart(2, '0')}</span>
          <span class="manifesti-card-content">
            <span class="manifesti-card-meta">{kindLabel(article)} · {article.data.publishedAt.toLocaleDateString('it-IT')} · {article.data.readTime}</span>
            <strong>{article.data.title}</strong>
            <span class="manifesti-card-description">{article.data.excerpt}</span>
            <span class="manifesti-card-cta">Apri la pubblicazione <b aria-hidden="true">↗</b></span>
          </span>
        </a>
      ))}
      <div class="manifesti-card-placeholder" aria-hidden="true" data-archive-placeholder></div>
      <div class="manifesti-card-placeholder" aria-hidden="true" data-archive-placeholder></div>
      <div class="manifesti-card-placeholder" aria-hidden="true" data-archive-placeholder></div>
      <div class="manifesti-card-placeholder" aria-hidden="true" data-archive-placeholder></div>
    </div>
    <p class="manifesti-no-results" data-archive-empty hidden>Nessuna pubblicazione corrisponde ai criteri scelti. Prova a modificare la ricerca o i filtri.</p>
    <p class="manifesti-archive-footnote">Gli spazi vuoti indicano soltanto le aree previste per le prossime pubblicazioni.</p>
  </section>

  <script>
    const archiveForm = document.querySelector<HTMLFormElement>('[data-archive-form]');
    const searchInput = document.querySelector<HTMLInputElement>('[data-archive-search]');
    const resetButton = document.querySelector<HTMLButtonElement>('[data-archive-reset]');
    const kindTags = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-archive-kind-tag]'));
    const themeTags = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-archive-theme-tag]'));
    const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-archive-card]'));
    const placeholders = Array.from(document.querySelectorAll<HTMLElement>('[data-archive-placeholder]'));
    const summary = document.querySelector<HTMLElement>('[data-archive-summary]');
    const emptyMessage = document.querySelector<HTMLElement>('[data-archive-empty]');
    const count = document.querySelector<HTMLElement>('[data-archive-count]');
    const normalize = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
    const selectedTags = (tags: HTMLButtonElement[]) => tags.filter((tag) => tag.getAttribute('aria-pressed') === 'true');
    const prettyLabels = (tags: HTMLButtonElement[]) => selectedTags(tags).map((tag) => tag.textContent?.trim() ?? '').filter(Boolean);

    const applyArchiveSearch = () => {
      const query = normalize(searchInput?.value ?? '');
      const chosenKinds = selectedTags(kindTags).map((tag) => tag.dataset.archiveKindTag ?? '');
      const chosenThemes = selectedTags(themeTags).map((tag) => normalize(tag.dataset.archiveThemeTag ?? ''));
      const hasFilters = Boolean(query || chosenKinds.length || chosenThemes.length);
      let visible = 0;

      for (const card of cards) {
        const searchableText = normalize(card.dataset.searchText ?? '');
        const cardKind = card.dataset.kind ?? '';
        const cardThemes = normalize(card.dataset.themes ?? '').split(/\s+/).filter(Boolean);
        const matchesQuery = !query || searchableText.includes(query);
        const matchesKind = !chosenKinds.length || chosenKinds.includes(cardKind);
        const matchesTheme = !chosenThemes.length || chosenThemes.some((theme) => cardThemes.some((cardTheme) => normalize(cardTheme) === theme));
        const matches = matchesQuery && matchesKind && matchesTheme;
        card.hidden = !matches;
        if (matches) visible += 1;
      }

      placeholders.forEach((placeholder) => { placeholder.hidden = hasFilters; });
      if (emptyMessage) emptyMessage.hidden = visible > 0;
      if (count) count.textContent = `${String(visible).padStart(2, '0')} ${visible === 1 ? 'PUBBLICAZIONE VISIBILE' : 'PUBBLICAZIONI VISIBILI'}`;
      if (summary) {
        const parts: string[] = [];
        if (query) parts.push(`Ricerca: “${searchInput?.value.trim() ?? ''}”`);
        const kinds = prettyLabels(kindTags);
        const themes = prettyLabels(themeTags);
        if (kinds.length) parts.push(`Tipo: ${kinds.join(', ')}`);
        if (themes.length) parts.push(`Tema: ${themes.join(', ')}`);
        summary.textContent = parts.length
          ? `${parts.join(' · ')} · ${visible} ${visible === 1 ? 'pubblicazione trovata' : 'pubblicazioni trovate'}.`
          : `Mostro tutte le ${visible} pubblicazioni.`;
      }
    };

    [...kindTags, ...themeTags].forEach((tag) => tag.addEventListener('click', () => {
      const nextState = tag.getAttribute('aria-pressed') !== 'true';
      tag.setAttribute('aria-pressed', String(nextState));
      tag.classList.toggle('is-selected', nextState);
      const kindCount = document.querySelector<HTMLElement>('[data-kind-count]');
      const themeCount = document.querySelector<HTMLElement>('[data-theme-count]');
      if (kindCount) kindCount.textContent = selectedTags(kindTags).length ? `(${selectedTags(kindTags).length})` : '';
      if (themeCount) themeCount.textContent = selectedTags(themeTags).length ? `(${selectedTags(themeTags).length})` : '';
    }));
    document.addEventListener('click', (event) => {
      const target = event.target;
      if (target instanceof Node && !target.closest('.manifesti-filter-dropdown')) {
        document.querySelectorAll<HTMLDetailsElement>('.manifesti-filter-dropdown[open]').forEach((dropdown) => { dropdown.open = false; });
      }
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') document.querySelectorAll<HTMLDetailsElement>('.manifesti-filter-dropdown[open]').forEach((dropdown) => { dropdown.open = false; });
    });
    archiveForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      applyArchiveSearch();
    });
    resetButton?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      [...kindTags, ...themeTags].forEach((tag) => {
        tag.setAttribute('aria-pressed', 'false');
        tag.classList.remove('is-selected');
      });
      document.querySelector<HTMLElement>('[data-kind-count]')!.textContent = '';
      document.querySelector<HTMLElement>('[data-theme-count]')!.textContent = '';
      document.querySelectorAll<HTMLDetailsElement>('.manifesti-filter-dropdown').forEach((dropdown) => { dropdown.open = false; });
      applyArchiveSearch();
      searchInput?.focus();
    });
    applyArchiveSearch();
  </script>
</Layout>
