---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { editorial } from '../data/site';

const now = new Date();
const articoli = (await getCollection('articoli', ({ data }) => data.publishedAt <= now))
  .filter((article) => article.id !== 'modello' && article.slug !== 'modello' && article.data.title !== 'Come pubblicare un nuovo articolo')
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const manifesti = articoli.filter((article) => article.data.category.toLowerCase() === 'manifesto');
const altriArticoli = articoli.filter((article) => article.data.category.toLowerCase() !== 'manifesto').slice(0, 4);
const manifestoInEvidenza = manifesti.find((a) => a.data.featured) ?? manifesti[0];
const base = import.meta.env.BASE_URL;
const relationArticle = articoli.find((article) => article.id.includes('come-scrivere-il-futuro-essendo-presenti'));
const piumaArticle = articoli.find((article) => article.id.startsWith('la-piuma'));
const relationHref = relationArticle ? `${base}articoli/${relationArticle.id}/` : `${base}articoli/come-scrivere-il-futuro-essendo-presenti.md/`;
const piumaHref = piumaArticle ? `${base}articoli/${piumaArticle.id}/` : `${base}articoli/la-piuma.md/`;
---

<Layout title="L'Unione Stampa — La rivoluzione del giornale.">
  <section class="hero hero-home">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow light">L'UNIONE STAMPA</p>
        <h1>La rivoluzione<br /><span>del giornale.</span></h1>
        <p class="hero-lede">La Piuma è il nuovo concetto editoriale dell'Unione Stampa: veloce, potente e progettato per stare nel palmo di una mano.</p>
        <div class="hero-actions">
          <a class="button button--light" href="#piuma">Scopri la Piuma</a>
          <a class="button button--ghost" href={`${base}manifesti/`}>Vai ai Manifesti</a>
        </div>
      </div>

      <div class="hero-brand">
        <img src={`${base}assets/logo-symbol-original.png`} alt="Simbolo de L'Unione Stampa" />
      </div>
    </div>
  </section>

  <section class="piuma-intro wrap" id="piuma">
    <div class="piuma-intro-copy">
      <p class="eyebrow">LA PIUMA</p>
      <h2>Veloce e potente<br />nel palmo di una mano.</h2>
      <p>La Piuma nasce da un lavoro di ingegneria editoriale: le pieghe sono pensate perché il giornale possa essere aperto progressivamente, letto anche con una sola mano, richiuso e tenuto sempre in tasca.</p>
    </div>
    <div class="piuma-intro-right">
    <div class="piuma-comparison" aria-label="Confronto tra giornale classico e La Piuma">
      <article class="piuma-comparison-side piuma-comparison-side--classic">
        <div class="piuma-comparison-heading">
          <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M9 12 33 8l5 29-24 4z"/><path d="M14 7 37 4l5 29"/><path d="M16 19 31 17M17 25 33 23M18 31 30 29"/></svg>
          <div><span>IL FORMATO TRADIZIONALE</span><strong>Giornale classico</strong></div>
        </div>
        <ul>
          <li>Molti fogli da gestire</li>
          <li>Lettura spesso dispersiva</li>
          <li>Percorso poco guidato</li>
          <li>Identità visiva meno incisiva</li>
          <li>Ingombro e pagine delicate</li>
          <li>Spesso destinato a essere scartato</li>
          <li>Può avere un costo</li>
        </ul>
      </article>
      <article class="piuma-comparison-side piuma-comparison-side--piuma">
        <div class="piuma-comparison-heading">
          <img src={`${base}assets/logo-piuma-bianca.png`} alt="" aria-hidden="true" />
          <div><span>IL FORMATO DE L'UNIONE STAMPA</span><strong>La Piuma</strong></div>
        </div>
        <ul>
          <li>Un solo foglio</li>
          <li>Informazione mirata</li>
          <li>Percorso di lettura progettato</li>
          <li>Pensata per una mano</li>
          <li>Compatta, sempre in tasca</li>
          <li>Distribuzione gratuita</li>
          <li>Un poster da conservare</li>
        </ul>
      </article>
    </div>
    </div>
  </section>

  <section class="piuma-section">
    <div class="wrap">
      <div class="section-head section-head--light">
        <div><p class="eyebrow light">APRILA</p><h2>Guarda cosa succede.</h2></div>
        <span class="section-rule section-rule--light" aria-hidden="true"></span>
      </div>
      <div class="piuma-preview" aria-label="Anteprima del progetto La Piuma, in sviluppo">
        <div class="piuma-preview__art">
          <span class="piuma-preview__label">ANTEPRIMA · IN SVILUPPO</span>
          <img src={`${base}assets/mano-e-piuma.png`} alt="Illustrazione a colori della Piuma, con la pubblicazione piegata in rosso su fondo beige" loading="lazy" />
        </div>
        <div class="piuma-preview__copy">
          <span class="eyebrow light">UNA NUOVA FORMA DI GIORNALE</span>
          <h3>La dimostrazione interattiva sarà disponibile a breve.</h3>
          <p>Stiamo preparando un'anteprima più vicina al modo in cui il foglio si apre davvero.</p>
        </div>
      </div>
      <p class="model-copyright">© {new Date().getFullYear()} L'Unione Stampa · Il modello disegnato e ideato per il giornale rappresenta la rivoluzione portata avanti esclusivamente dall'Unione di Luca Barretta Lalic.</p>
    </div>
  </section>

  <section class="manifesto-section wrap" id="manifesto">
    <div class="section-head manifesto-carousel-head">
      <div><p class="eyebrow">PENSIERO, STAMPA, AZIONE</p><h2>Manifesti</h2></div>
      <span class="section-rule" aria-hidden="true"></span>
      <div class="manifesto-carousel-controls" aria-label="Controlli del carosello">
        <button class="manifesto-carousel-arrow manifesto-carousel-prev" type="button" data-manifesto-prev aria-label="Torna alle pubblicazioni precedenti" disabled aria-disabled="true">
          <span aria-hidden="true">←</span>
        </button>
        <button class="manifesto-carousel-arrow manifesto-carousel-next" type="button" data-manifesto-next aria-label="Scorri verso le prossime pubblicazioni">
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>

    <div class="manifesto-carousel-viewport" data-manifesto-viewport>
    <div class="manifesto-carousel-track" data-manifesto-carousel tabindex="0" role="list" aria-label="Carosello delle pubblicazioni">
      <a class="manifesto-carousel-card manifesto-carousel-card--archive" role="listitem" href={`${base}manifesti/`} aria-label="Apri tutti i manifesti" style={`--manifesto-image: url("${base}assets/sparviera-legge-prato.png")`}>
        <span class="manifesto-carousel-number">ARCHIVIO EDITORIALE · {String(manifesti.length).padStart(2, '0')} USCITE</span>
        <span class="manifesto-carousel-copy">
          <strong>Tutti i manifesti.</strong>
          <span>Relazioni, idee e pubblicazioni dell'Unione Stampa raccolte in un unico luogo.</span>
          <span class="manifesto-carousel-cta">Apri l'archivio <b aria-hidden="true">↗</b></span>
        </span>
      </a>

      <a class="manifesto-carousel-card" role="listitem" data-relation-link href={relationHref} aria-label="Leggi Come scrivere il futuro essendo presenti" style={`--manifesto-image: url("${base}assets/copertina-come-scrivere-il-futuro.png")`}>
        <span class="manifesto-carousel-badges"><span class="manifesto-carousel-number">01 / 02</span><span class="manifesto-carousel-featured">IN EVIDENZA</span></span>
        <span class="manifesto-carousel-copy">
          <span class="manifesto-carousel-meta">RELAZIONE · 09 OTT 2026 · 4 MIN</span>
          <strong>Come scrivere il futuro essendo presenti</strong>
          <span>Un'analisi socio-politica su giovani, società e potere decisionale.</span>
          <span class="manifesto-carousel-cta">Leggi la relazione <b aria-hidden="true">↗</b></span>
        </span>
      </a>

      <a class="manifesto-carousel-card manifesto-carousel-card--piuma" role="listitem" href={piumaHref} aria-label="Leggi il manifesto La Piuma" style={`--manifesto-image: url("${base}assets/la-piuma-home-card.png")`}>
        <span class="manifesto-carousel-badges"><span class="manifesto-carousel-number">02 / 02</span><span class="manifesto-carousel-featured">IN EVIDENZA</span></span>
        <span class="manifesto-carousel-copy">
          <span class="manifesto-carousel-meta">PROGETTO EDITORIALE · 08 OTT 2026 · 2 MIN</span>
          <strong>La Piuma</strong>
          <span>Il giornale tascabile che si apre nel palmo di una mano e rivela un poster.</span>
          <span class="manifesto-carousel-cta">Scopri il progetto <b aria-hidden="true">↗</b></span>
        </span>
      </a>

      <div class="manifesto-carousel-item manifesto-carousel-placeholder" role="listitem" aria-label="Spazio riservato a una prossima pubblicazione">
        <span class="manifesto-placeholder-label">PROSSIMAMENTE</span>
        <span class="manifesto-placeholder-caption">Nuova pubblicazione</span>
      </div>

      <div class="manifesto-carousel-item manifesto-carousel-placeholder" role="listitem" aria-label="Spazio riservato a una prossima pubblicazione">
        <span class="manifesto-placeholder-label">PROSSIMAMENTE</span>
        <span class="manifesto-placeholder-caption">Nuova pubblicazione</span>
      </div>
    </div>
    </div>
    <div class="manifesto-carousel-progress" role="group" aria-label="Avanzamento del carosello">
      <div class="manifesto-carousel-progress-head">
        <label for="manifesto-carousel-range">SCORRI LE PUBBLICAZIONI</label>
        <output data-manifesto-progress-text for="manifesto-carousel-range">0%</output>
      </div>
      <input id="manifesto-carousel-range" class="manifesto-carousel-range" type="range" min="0" max="100" step="0.1" value="0" data-manifesto-progress aria-label="Posizione nel carosello. Trascina la barra o usa la rotella del mouse sopra di essa." />
      <p class="manifesto-carousel-progress-hint">Trascina la barra o usa la rotella del mouse qui per scorrere.</p>
    </div>
  </section>

  <section class="release-section" id="luoghi">
    <div class="wrap release-grid">
      <div>
        <p class="eyebrow light">DISTRIBUZIONE</p>
        <h2>Luoghi di rilascio.</h2>
        <p>Qui compariranno i luoghi e le campagne in cui trovare fisicamente le Piume. Per il momento la rete di distribuzione è ancora in costruzione.</p>
      </div>
      <div class="release-card release-card--inactive" tabindex="0" aria-label="Luoghi di rilascio: funzionalità al momento inattiva">
        <div class="release-map-background" aria-hidden="true">
          <iframe src="https://maps.google.com/maps?q=Italia&z=5&output=embed" title="Mappa geografica dell'Italia — anteprima disattivata" loading="lazy" tabindex="-1" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
        <span class="release-card__stamp">PROSSIMAMENTE</span>
        <strong>Nessun punto<br />pubblicato ancora.</strong>
        <p>Segui <a href={editorial.social.instagramUsUrl} rel="noreferrer">@unionestampa</a> per gli annunci dei prossimi rilasci.</p>
        <span class="release-card__inactive-note" aria-hidden="true">Funzionalità al momento inattiva</span>
      </div>
    </div>
  </section>

  <section class="free-section">
    <div class="wrap free-card">
      <div class="free-artwork"><img src={`${base}assets/spada-euro-dollaro.png`} alt="Una spada rossa attraversa i simboli del dollaro e dell'euro" loading="lazy" /></div>
      <div class="free-copy">
        <p class="eyebrow">UNA SCELTA</p>
        <h2><span>Gratis</span><span>Senza Abbonamento.</span><span>Senza Vendita.</span></h2>
        <p>L'Unione Stampa sceglie un'editoria accessibile: le pubblicazioni sono gratuite, senza abbonamenti e senza vendita.</p>
        <p>Ogni eventuale donazione sarà comunicata con criteri pubblici e destinata secondo le finalità dichiarate dall'Unione.</p>
      </div>
    </div>
  </section>

  {altriArticoli.length > 0 && (
    <section class="articles-section wrap">
      <div class="section-head">
        <div><p class="eyebrow">DALLA REDAZIONE</p><h2>Articoli</h2></div>
        <span class="section-rule" aria-hidden="true"></span>
      </div>
      <div class="news-grid news-grid--three">
        {altriArticoli.map((article) => (
          <article class="news-card">
            <div class="featured-meta"><span>{article.data.category}</span><time datetime={article.data.publishedAt.toISOString()}>{article.data.publishedAt.toLocaleDateString('it-IT')}</time><span>{article.data.readTime}</span></div>
            <h3><a href={`${base}articoli/${article.id}/`}>{article.data.title}</a></h3>
            <p>{article.data.excerpt}</p>
            <a class="read-link" href={`${base}articoli/${article.id}/`}>Continua →</a>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="next-section" id="prossima">
    <div class="wrap next-grid">
      <div>
        <p class="eyebrow light">PROSSIMA USCITA</p>
        <h2>{editorial.nextIssue.label}<br /><small>{editorial.nextIssue.title}</small></h2>
      </div>
      <div class="next-box">
        <span class="next-box__label">NOTIFIER</span>
        <button type="button" class="button button--locked" disabled aria-disabled="true">Avvisami</button>
        <p>Il pulsante verrà attivato quando il sistema di notifica sarà pronto.</p>
      </div>
    </div>
  </section>

  <section class="social-contact-section wrap" id="social">
    <div class="social-grid">
      <div class="social-block">
        <p class="eyebrow">SOCIAL</p>
        <h2>Seguici dove nascono i rilasci.</h2>
        <a class="social-link" href={editorial.social.instagramUsUrl} rel="noreferrer"><span>Instagram</span><strong>{editorial.social.instagramUs}</strong> ↗</a>
        <a class="social-link" href={editorial.social.instagramMotherUrl} rel="noreferrer"><span>Organizzazione madre</span><strong>{editorial.social.instagramMother}</strong> ↗</a>
      </div>
      <div class="contact-block" id="contatti">
        <p class="eyebrow">CONTATTI</p>
        <h2>Una collaborazione seria?</h2>
        <p>Per collaborazioni, proposte editoriali, distribuzione, segnalazioni importanti o comunicazioni che meritano una risposta, scrivi a:</p>
        <a class="contact-email" href={`mailto:${editorial.contact.email}`}>{editorial.contact.email}</a>
      </div>
    </div>
  </section>
</Layout>


<script>
  const manifestoCarousel = document.querySelector<HTMLDivElement>('[data-manifesto-carousel]');
  const manifestoPrev = document.querySelector<HTMLButtonElement>('[data-manifesto-prev]');
  const manifestoNext = document.querySelector<HTMLButtonElement>('[data-manifesto-next]');
  const manifestoProgress = document.querySelector<HTMLInputElement>('[data-manifesto-progress]');
  const manifestoProgressText = document.querySelector<HTMLOutputElement>('[data-manifesto-progress-text]');

  if (manifestoCarousel && manifestoPrev && manifestoNext && manifestoProgress && manifestoProgressText) {
    const carouselItems = () => Array.from(manifestoCarousel.querySelectorAll<HTMLElement>(':scope > [role="listitem"]'));
    const reducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Posizione di aggancio di ciascuna scheda rispetto all'inizio visibile del carosello.
    const getStops = () => {
      const trackRect = manifestoCarousel.getBoundingClientRect();
      const paddingLeft = Number.parseFloat(window.getComputedStyle(manifestoCarousel).paddingLeft) || 0;
      return carouselItems().map((item) => Math.max(0,
        item.getBoundingClientRect().left - trackRect.left + manifestoCarousel.scrollLeft - paddingLeft
      ));
    };

    const getMaxScroll = () => Math.max(0, manifestoCarousel.scrollWidth - manifestoCarousel.clientWidth);

    const updateManifestoControls = () => {
      const maxScroll = getMaxScroll();
      const atStart = manifestoCarousel.scrollLeft <= 3;
      const atEnd = manifestoCarousel.scrollLeft >= maxScroll - 3;
      manifestoPrev.disabled = atStart;
      manifestoPrev.setAttribute('aria-disabled', String(atStart));
      manifestoNext.disabled = atEnd;
      manifestoNext.setAttribute('aria-disabled', String(atEnd));

      const percentage = maxScroll > 0 ? Math.min(100, Math.max(0, (manifestoCarousel.scrollLeft / maxScroll) * 100)) : 0;
      manifestoProgress.value = String(percentage);
      manifestoProgress.style.setProperty('--progress', `${percentage}%`);
      manifestoProgressText.value = `${Math.round(percentage)}%`;
      manifestoProgressText.textContent = `${Math.round(percentage)}%`;
      manifestoProgress.setAttribute('aria-valuetext', `${Math.round(percentage)}% del carosello visualizzato`);
    };

    const scrollToStop = (direction: -1 | 1) => {
      const stops = getStops();
      const current = manifestoCarousel.scrollLeft;
      const target = direction > 0
        ? stops.find((stop) => stop > current + 18)
        : [...stops].reverse().find((stop) => stop < current - 18);
      const maxScroll = getMaxScroll();
      const destination = target ?? (direction > 0 ? maxScroll : 0);
      manifestoCarousel.scrollTo({ left: Math.max(0, Math.min(maxScroll, destination)), behavior: reducedMotion() ? 'auto' : 'smooth' });
    };

    manifestoPrev.addEventListener('click', () => scrollToStop(-1));
    manifestoNext.addEventListener('click', () => scrollToStop(1));
    manifestoCarousel.addEventListener('scroll', updateManifestoControls, { passive: true });
    window.addEventListener('resize', updateManifestoControls);

    // La barra è interattiva: click e trascinamento portano alla posizione scelta.
    manifestoProgress.addEventListener('input', () => {
      const maxScroll = getMaxScroll();
      const destination = maxScroll * (Number(manifestoProgress.value) / 100);
      manifestoCarousel.scrollTo({ left: destination, behavior: 'auto' });
      updateManifestoControls();
    });

    // La rotella viene convertita in movimento orizzontale solo sopra la barra, non sulle schede.
    manifestoProgress.addEventListener('wheel', (event) => {
      if (event.ctrlKey) return; // Conserva lo zoom del browser.
      const delta = Math.abs(event.deltaY) >= Math.abs(event.deltaX) ? event.deltaY : event.deltaX;
      if (!delta) return;
      const maxScroll = getMaxScroll();
      const atStart = manifestoCarousel.scrollLeft <= 1;
      const atEnd = manifestoCarousel.scrollLeft >= maxScroll - 1;
      if ((delta < 0 && atStart) || (delta > 0 && atEnd) || maxScroll <= 1) return;
      event.preventDefault();
      manifestoCarousel.scrollBy({ left: delta * 1.35, behavior: 'auto' });
    }, { passive: false });

    updateManifestoControls();
    requestAnimationFrame(updateManifestoControls);
  }
</script>
