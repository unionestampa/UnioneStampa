---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { editorial } from '../data/site';

const now = new Date();
const articoli = (await getCollection('articoli', ({ data }) => data.publishedAt <= now))
  .filter((article) => article.id !== 'modello' && article.slug !== 'modello' && article.data.title !== 'Come pubblicare un nuovo articolo')
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const altriArticoli = articoli.filter((article) => article.data.category.toLowerCase() !== 'manifesto').slice(0, 4);
const base = import.meta.env.BASE_URL;
const relationArticle = articoli.find((article) => article.id.includes('come-scrivere-il-futuro-essendo-presenti'));
const piumaArticle = articoli.find((article) => article.id.startsWith('la-piuma'));
const relationHref = relationArticle ? `${base}articoli/${relationArticle.id}/` : `${base}articoli/come-scrivere-il-futuro-essendo-presenti.md/`;
const piumaHref = piumaArticle ? `${base}articoli/${piumaArticle.id}/` : `${base}articoli/la-piuma.md/`;
---

<Layout title="L'Unione Stampa · La rivoluzione del giornale.">
  <section class="hero hero-home">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow light">L'UNIONE STAMPA</p>
        <h1>La rivoluzione<br /><span>del giornale.</span></h1>
        <p class="hero-lede">La Piuma è il nuovo concetto editoriale dell'Unione Stampa: veloce, potente e progettato per stare nel palmo di una mano.</p>
        <div class="hero-actions">
          <a class="button button--light" href="#piuma">Scopri la Piuma</a>
          <a class="button button--ghost" href={`${base}manifesti/`}>Vai ai Manifesti</a>
        </div>
      </div>

      <div class="hero-brand">
        <img src={`${base}images/brand/brand-simbolo-piuma-originale.png`} alt="Simbolo de L'Unione Stampa" />
      </div>
    </div>
  </section>

  <section class="piuma-intro wrap" id="piuma">
    <div class="piuma-intro-copy">
      <p class="eyebrow">LA PIUMA</p>
      <h2>Veloce e potente<br />nel palmo di una mano.</h2>
      <p>La Piuma nasce da un lavoro di ingegneria editoriale: le pieghe sono pensate perché il giornale possa essere aperto progressivamente, letto anche con una sola mano, richiuso e tenuto sempre in tasca.</p>
    </div>
    <div class="piuma-intro-right">
    <div class="piuma-comparison" aria-label="Confronto tra giornale classico e La Piuma">
      <article class="piuma-comparison-side piuma-comparison-side--classic">
        <div class="piuma-comparison-heading">
          <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M9 12 33 8l5 29-24 4z"/><path d="M14 7 37 4l5 29"/><path d="M16 19 31 17M17 25 33 23M18 31 30 29"/></svg>
          <div><span>IL FORMATO TRADIZIONALE</span><strong>Giornale classico</strong></div>
        </div>
        <ul>
          <li>Molti fogli da gestire</li>
          <li>Lettura spesso dispersiva</li>
          <li>Percorso poco guidato</li>
          <li>Identità visiva meno incisiva</li>
          <li>Ingombro e pagine delicate</li>
          <li>Spesso destinato a essere scartato</li>
          <li>Può avere un costo</li>
        </ul>
      </article>
      <article class="piuma-comparison-side piuma-comparison-side--piuma">
        <div class="piuma-comparison-heading">
          <img src={`${base}images/brand/brand-simbolo-piuma-bianco.png`} alt="" aria-hidden="true" />
          <div><span>IL FORMATO DE L'UNIONE STAMPA</span><strong>La Piuma</strong></div>
        </div>
        <ul>
          <li>Un solo foglio</li>
          <li>Informazione mirata</li>
          <li>Percorso di lettura progettato</li>
          <li>Pensata per una mano</li>
          <li>Compatta, sempre in tasca</li>
          <li>Distribuzione gratuita</li>
          <li>Un poster da conservare</li>
        </ul>
      </article>
    </div>
    </div>
  </section>

  <section class="piuma-section">
    <div class="wrap">
      <div class="section-head section-head--light">
        <div><p class="eyebrow light">APRILA</p><h2>Guarda cosa succede.</h2></div>
        <span class="section-rule section-rule--light" aria-hidden="true"></span>
      </div>
      <div class="piuma-preview" aria-label="Anteprima del progetto La Piuma, in sviluppo">
        <div class="piuma-preview__art">
          <span class="piuma-preview__label">ANTEPRIMA · IN SVILUPPO</span>
          <img src={`${base}images/illustrazioni/piuma-illustrazione-mano.png`} alt="Illustrazione a colori della Piuma, con la pubblicazione piegata in rosso su fondo beige" loading="lazy" />
        </div>
        <div class="piuma-preview__copy">
          <span class="eyebrow light">UNA NUOVA FORMA DI GIORNALE</span>
          <h3>La dimostrazione interattiva sarà disponibile a breve.</h3>
          <p>Stiamo preparando un'anteprima più vicina al modo in cui il foglio si apre davvero.</p>
        </div>
      </div>
      <p class="model-copyright">© {new Date().getFullYear()} L'Unione Stampa · Il modello disegnato e ideato per il giornale rappresenta la rivoluzione portata avanti esclusivamente dall'Unione di Luca Barretta Lalic.</p>
    </div>
  </section>

  <section class="manifesto-showcase wrap" id="manifesto" aria-labelledby="manifesti-home-title">
    <div class="section-head manifesto-showcase-head">
      <div><p class="eyebrow">PENSIERO, STAMPA, AZIONE</p><h2 id="manifesti-home-title">Manifesti</h2></div>
      <span class="section-rule" aria-hidden="true"></span>
    </div>

    <div class="manifesto-showcase-grid">
      <a class="manifesto-showcase-main" href={`${base}manifesti/`} aria-label="Apri tutti i manifesti" style={`--manifesto-image: url("${base}images/manifesti/manifesti-archivio-lettrice.png")`}>
        <span class="manifesto-showcase-topline">ARCHIVIO EDITORIALE · {String(articoli.length).padStart(2, '0')} USCITE</span>
        <span class="manifesto-showcase-main-copy">
          <strong>Tutti i manifesti</strong>
          <span>Relazioni, articoli e pubblicazioni dell'Unione Stampa, raccolti in un unico spazio.</span>
          <span class="manifesto-showcase-cta">Apri l'archivio <b aria-hidden="true">↗</b></span>
        </span>
      </a>

      <div class="manifesto-rail" role="group" aria-label="Altre pubblicazioni">
        <button class="manifesto-rail-arrow" type="button" data-manifesto-rail-up aria-controls="manifesto-home-rail" aria-label="Scorri le pubblicazioni verso l'alto" disabled aria-disabled="true"><span aria-hidden="true">↑</span></button>
        <div class="manifesto-rail-track" id="manifesto-home-rail" data-manifesto-rail tabindex="0" role="list" aria-label="Scorri verticalmente le pubblicazioni">
          <a class="manifesto-horizontal-card" role="listitem" data-manifesto-rail-item href={relationHref} aria-label="Apri Come scrivere il futuro essendo presenti" style={`--manifesto-image: url("${base}images/pubblicazioni/copertina-relazione-futuro.png")`}>
            <span class="manifesto-new-badge"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5 14.4 9.6 20.5 12l-6.1 2.4L12 20.5l-2.4-6.1L3.5 12l6.1-2.4Z"/><path d="m19 2 .9 2.1L22 5l-2.1.9L19 8l-.9-2.1L16 5l2.1-.9Z"/></svg><span>Novità</span></span>
            <span class="manifesto-horizontal-copy"><span class="manifesto-horizontal-meta">RELAZIONE · 09 OTT 2026</span><strong>Come scrivere il futuro essendo presenti</strong><span class="manifesto-horizontal-arrow" aria-hidden="true">↗</span></span>
          </a>
          <a class="manifesto-horizontal-card" role="listitem" data-manifesto-rail-item href={piumaHref} aria-label="Apri La Piuma" style={`--manifesto-image: url("${base}images/manifesti/manifesto-la-piuma-copertina-home.png")`}>
            <span class="manifesto-new-badge"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5 14.4 9.6 20.5 12l-6.1 2.4L12 20.5l-2.4-6.1L3.5 12l6.1-2.4Z"/><path d="m19 2 .9 2.1L22 5l-2.1.9L19 8l-.9-2.1L16 5l2.1-.9Z"/></svg><span>Novità</span></span>
            <span class="manifesto-horizontal-copy"><span class="manifesto-horizontal-meta">MANIFESTO · 08 OTT 2026</span><strong>La Piuma: il giornale che si apre nel palmo</strong><span class="manifesto-horizontal-arrow" aria-hidden="true">↗</span></span>
          </a>
          <div class="manifesto-rail-placeholder" role="listitem" aria-label="Spazio vuoto riservato a una futura pubblicazione"></div>
          <div class="manifesto-rail-placeholder" role="listitem" aria-label="Spazio vuoto riservato a una futura pubblicazione"></div>
          <div class="manifesto-rail-placeholder" role="listitem" aria-label="Spazio vuoto riservato a una futura pubblicazione"></div>
        </div>
        <button class="manifesto-rail-arrow" type="button" data-manifesto-rail-down aria-controls="manifesto-home-rail" aria-label="Scorri le pubblicazioni verso il basso"><span aria-hidden="true">↓</span></button>
      </div>
    </div>
  </section>

  <section class="release-section" id="luoghi">
    <div class="wrap release-grid">
      <div>
        <p class="eyebrow light">DISTRIBUZIONE</p>
        <h2>Luoghi di rilascio.</h2>
        <p>Qui compariranno i luoghi e le campagne in cui trovare fisicamente le Piume. Per il momento la rete di distribuzione è ancora in costruzione.</p>
      </div>
      <div class="release-card release-card--inactive" tabindex="0" aria-label="Luoghi di rilascio: funzionalità al momento inattiva">
        <div class="release-map-background" aria-hidden="true">
          <iframe src="https://maps.google.com/maps?q=Italia&z=5&output=embed" title="Mappa geografica dell'Italia — anteprima disattivata" loading="lazy" tabindex="-1" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
        <span class="release-card__stamp">PROSSIMAMENTE</span>
        <strong>Nessun punto<br />pubblicato ancora.</strong>
        <p>Segui <a href={editorial.social.instagramUsUrl} rel="noreferrer">@unionestampa</a> per gli annunci dei prossimi rilasci.</p>
        <span class="release-card__inactive-note" aria-hidden="true">Funzionalità al momento inattiva</span>
      </div>
    </div>
  </section>

  <section class="visual-archive-section" aria-labelledby="visual-archive-title">
    <div class="wrap">
      <div class="section-head section-head--light">
        <div><p class="eyebrow light">DIETRO LE QUINTE</p><h2 id="visual-archive-title">Archivio visivo</h2></div>
        <span class="section-rule section-rule--light" aria-hidden="true"></span>
      </div>
      <div class="visual-archive-card" role="group" aria-labelledby="visual-archive-title">
        <div class="visual-archive-icon" aria-hidden="true">
          <svg viewBox="0 0 64 64"><path d="M8 21h48v34H8z"/><path d="M5 12h54v12H5z"/><path d="M26 33h12M23 40h18"/><path d="M15 12V7h34v5"/></svg>
        </div>
        <div class="visual-archive-copy">
          <span class="visual-archive-status"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg> BLOCCATO · ARRIVA A BREVE</span>
          <h3>Il lavoro creativo, prima che diventi immagine.</h3>
          <p>Un archivio digitale dedicato alla creazione visiva e artistica dell'Unione Sparvieri, curata dalla direzione artistica di Unione Stampa: video e fotografie di backstage, bozze, progetti, materiali di lavorazione e opere che raccontano il percorso creativo dell'Unione.</p>
        </div>
        <span class="visual-archive-locked-note">ACCESSO NON ANCORA DISPONIBILE</span>
      </div>
    </div>
  </section>

  {altriArticoli.length > 0 && (
    <section class="articles-section wrap">
      <div class="section-head">
        <div><p class="eyebrow">DALLA REDAZIONE</p><h2>Articoli</h2></div>
        <span class="section-rule" aria-hidden="true"></span>
      </div>
      <div class="news-grid news-grid--three">
        {altriArticoli.map((article) => (
          <article class="news-card">
            <div class="featured-meta"><span>{article.data.category}</span><time datetime={article.data.publishedAt.toISOString()}>{article.data.publishedAt.toLocaleDateString('it-IT')}</time><span>{article.data.readTime}</span></div>
            <h3><a href={`${base}articoli/${article.id}/`}>{article.data.title}</a></h3>
            <p>{article.data.excerpt}</p>
            <a class="read-link" href={`${base}articoli/${article.id}/`}>Continua →</a>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="next-section" id="prossima">
    <div class="wrap next-grid">
      <div>
        <p class="eyebrow light">PROSSIMA USCITA</p>
        <h2>{editorial.nextIssue.label}<br /><small>{editorial.nextIssue.title}</small></h2>
      </div>
      <div class="next-box">
        <span class="next-box__label">NOTIFIER</span>
        <button type="button" class="button button--locked" disabled aria-disabled="true">Avvisami</button>
        <p>Il pulsante verrà attivato quando il sistema di notifica sarà pronto.</p>
      </div>
    </div>
  </section>

  <section class="social-contact-section wrap" id="social">
    <div class="social-grid">
      <div class="social-block">
        <p class="eyebrow">SOCIAL</p>
        <h2>Seguici dove nascono i rilasci.</h2>
        <div class="social-links-list">
          <a class="social-link" href={editorial.social.instagramUsUrl} rel="noopener noreferrer" target="_blank">
            <img src={`${base}images/brand/instagram-mark.png`} alt="" width="34" height="34" loading="lazy" />
            <strong>{editorial.social.instagramUs}</strong><span>Editoria</span><b aria-hidden="true">↗</b>
          </a>
          <div class="social-link-divider" aria-hidden="true"></div>
          <a class="social-link" href={editorial.social.instagramMotherUrl} rel="noopener noreferrer" target="_blank">
            <img src={`${base}images/brand/instagram-mark.png`} alt="" width="34" height="34" loading="lazy" />
            <strong>{editorial.social.instagramMother}</strong><span>Organizzazione</span><b aria-hidden="true">↗</b>
          </a>
        </div>
      </div>
      <div class="contact-block" id="contatti">
        <p class="eyebrow">CONTATTI</p>
        <h2>Una collaborazione seria?</h2>
        <p>Per collaborazioni, proposte editoriali, distribuzione, segnalazioni importanti o comunicazioni che meritano una risposta, scrivi a:</p>
        <a class="contact-email" href={`mailto:${editorial.contact.email}`}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg><span>{editorial.contact.email}</span></a>
      </div>
    </div>
  </section>
</Layout>


<script>
  const manifestoRail = document.querySelector<HTMLDivElement>('[data-manifesto-rail]');
  const manifestoRailUp = document.querySelector<HTMLButtonElement>('[data-manifesto-rail-up]');
  const manifestoRailDown = document.querySelector<HTMLButtonElement>('[data-manifesto-rail-down]');

  if (manifestoRail && manifestoRailUp && manifestoRailDown) {
    const railItems = () => Array.from(manifestoRail.querySelectorAll<HTMLElement>(':scope > [data-manifesto-rail-item], :scope > .manifesto-rail-placeholder'));
    const reducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const updateRailControls = () => {
      const maxScroll = Math.max(0, manifestoRail.scrollHeight - manifestoRail.clientHeight);
      const atTop = manifestoRail.scrollTop <= 2;
      const atBottom = manifestoRail.scrollTop >= maxScroll - 2;
      manifestoRailUp.disabled = atTop;
      manifestoRailDown.disabled = atBottom;
      manifestoRailUp.setAttribute('aria-disabled', String(atTop));
      manifestoRailDown.setAttribute('aria-disabled', String(atBottom));
    };
    const stepRail = (direction: -1 | 1) => {
      const items = railItems();
      const current = manifestoRail.scrollTop;
      const itemPositions = items.map((item) => ({
        item,
        top: item.getBoundingClientRect().top - manifestoRail.getBoundingClientRect().top + current,
      }));
      const target = direction > 0
        ? itemPositions.find(({ top }) => top > current + 12)
        : [...itemPositions].reverse().find(({ top }) => top < current - 12);
      const maxScroll = Math.max(0, manifestoRail.scrollHeight - manifestoRail.clientHeight);
      const nextTop = target ? Math.max(0, Math.min(maxScroll, target.top)) : (direction > 0 ? maxScroll : 0);
      manifestoRail.scrollTo({ top: nextTop, behavior: reducedMotion() ? 'auto' : 'smooth' });
    };
    manifestoRailUp.addEventListener('click', () => stepRail(-1));
    manifestoRailDown.addEventListener('click', () => stepRail(1));
    manifestoRail.addEventListener('scroll', updateRailControls, { passive: true });
    window.addEventListener('resize', updateRailControls);
    updateRailControls();
    requestAnimationFrame(updateRailControls);
  }
</script>
