---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PiumaDemo from '../components/PiumaDemo.astro';
import { editorial } from '../data/site';

const now = new Date();
const articoli = (await getCollection('articoli', ({ data }) => data.publishedAt <= now))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const manifesti = articoli.filter((article) => article.data.category.toLowerCase() === 'manifesto');
const altriArticoli = articoli.filter((article) => article.data.category.toLowerCase() !== 'manifesto').slice(0, 4);
const manifestoInEvidenza = manifesti.find((a) => a.data.featured) ?? manifesti[0];
const base = import.meta.env.BASE_URL;
---

<Layout title="L'Unione Stampa — La rivoluzione del giornale.">
  <section class="hero hero-home">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow light">L'UNIONE STAMPA</p>
        <h1>La rivoluzione<br /><span>del giornale.</span></h1>
        <p class="hero-lede">La Piuma è il nuovo concetto editoriale dell'Unione Stampa: veloce, potente e progettato per stare nel palmo di una mano.</p>
        <div class="hero-actions">
          <a class="button button--light" href="#piuma">Scopri la Piuma</a>
          <a class="button button--ghost" href="#manifesto">Vai al Manifesto</a>
        </div>
        <p class="hero-subnote">Editoria gratuita · nessun abbonamento · nessuna vendita.</p>
      </div>

      <div class="hero-brand">
        <img src={`${base}assets/logo-symbol-original.png`} alt="Simbolo de L'Unione Stampa" />
      </div>
    </div>
  </section>

  <section class="piuma-intro wrap" id="piuma">
    <div class="piuma-intro-copy">
      <p class="eyebrow">LA PIUMA</p>
      <h2>Veloce e potente<br />nel palmo di una mano.</h2>
      <p>La Piuma nasce da un lavoro di ingegneria editoriale: le pieghe sono pensate perché il giornale possa essere aperto progressivamente, letto anche con una sola mano, richiuso e tenuto sempre in tasca.</p>
    </div>
    <div class="piuma-stats">
      <div><strong>1 mano</strong><span>progettata per la lettura</span></div>
      <div><strong>1 tasca</strong><span>forma compatta da portare</span></div>
      <div><strong>1 poster</strong><span>nascosto all'interno</span></div>
    </div>
  </section>

  <section class="piuma-section">
    <div class="wrap">
      <div class="section-head section-head--light">
        <div><p class="eyebrow light">APRILA</p><h2>Guarda cosa succede.</h2></div>
        <span class="section-rule section-rule--light" aria-hidden="true"></span>
      </div>
      <PiumaDemo />
      <p class="model-copyright">© {new Date().getFullYear()} L'Unione Stampa · Il modello disegnato e ideato per il giornale rappresenta la rivoluzione portata avanti esclusivamente dall'Unione di Luca Barretta Lalic.</p>
    </div>
  </section>

  <section class="manifesto-section wrap" id="manifesto">
    <div class="section-head">
      <div><p class="eyebrow">UNA DELLE NOSTRE PAGINE CENTRALI</p><h2>Manifesto</h2></div>
      <span class="section-rule" aria-hidden="true"></span>
    </div>

    <div class="manifesto-grid">
      <div class="manifesto-lead">
        {manifestoInEvidenza ? (
          <>
            <div class="manifesto-meta"><span>{manifestoInEvidenza.data.category}</span><time datetime={manifestoInEvidenza.data.publishedAt.toISOString()}>{manifestoInEvidenza.data.publishedAt.toLocaleDateString('it-IT')}</time></div>
            <h3><a href={`${base}articoli/${manifestoInEvidenza.id}/`}>{manifestoInEvidenza.data.title}</a></h3>
            <p>{manifestoInEvidenza.data.excerpt}</p>
            <a class="read-link" href={`${base}articoli/${manifestoInEvidenza.id}/`}>Apri il Manifesto →</a>
          </>
        ) : (
          <>
            <span class="manifesto-number">01</span>
            <h3>Le notizie che riguardano direttamente L'Unione Stampa vivranno qui.</h3>
            <p>Il Manifesto raccoglierà gli annunci e i passaggi più importanti del progetto: nuove Piume, campagne, scelte editoriali e prese di posizione dell'Unione.</p>
          </>
        )}
      </div>

      <div class="manifesto-side">
        <a class="manifesto-side-card manifesto-book-link" href={`${base}articoli/come-scrivere-il-futuro-essendo-presenti/`}>
          <span>NUOVA PUBBLICAZIONE · 01</span><strong>Come scrivere il futuro essendo presenti</strong><p>La prima relazione stampata dall'Unione Sparvieri, a cura di Luca Barretta Lalic.</p><b>Scopri il libro ↗</b>
        </a>
        <a class="manifesto-side-card manifesto-book-link" href={`${base}articoli/la-piuma/`}><span>PROGETTO EDITORIALE · 02</span><strong>La Piuma</strong><p>Il formato tascabile che si apre e rivela un poster.</p><b>Leggi il Manifesto ↗</b></a>
        <div class="manifesto-side-card"><span>03</span><strong>Distribuzione</strong><p>Nuove campagne e luoghi di rilascio saranno annunciati qui.</p></div>
      </div>
    </div>
  </section>

  <section class="release-section" id="luoghi">
    <div class="wrap release-grid">
      <div>
        <p class="eyebrow light">DISTRIBUZIONE</p>
        <h2>Luoghi di rilascio.</h2>
        <p>Qui compariranno i luoghi e le campagne in cui trovare fisicamente le Piume. Per il momento la rete di distribuzione è ancora in costruzione.</p>
      </div>
      <div class="release-card">
        <span class="release-card__stamp">PROSSIMAMENTE</span>
        <strong>Nessun punto<br />pubblicato ancora.</strong>
        <p>Segui <a href={editorial.social.instagramUsUrl} rel="noreferrer">@unionestampa</a> per gli annunci dei prossimi rilasci.</p>
      </div>
    </div>
  </section>

  <section class="free-section wrap">
    <div class="free-card">
      <div>
        <p class="eyebrow">UNA SCELTA, PER ORA</p>
        <h2>Gratis. Senza abbonamento. Senza vendita.</h2>
      </div>
      <div class="free-copy">
        <p>Per il momento l'editoria figlia dell'Unione Stampa presenta il progetto in forma gratuita, senza costi di abbonamento o vendita. L'obiettivo è ottimizzare e promuovere la distribuzione e le campagne dell'Unione.</p>
        <p>In futuro potranno essere accettate donazioni: saranno spartite, con criteri pubblici, con le dovute associazioni benefiche. Una sezione dedicata alla <strong>trasparenza economica</strong> verrà aggiunta quando il sistema sarà attivo.</p>
      </div>
    </div>
  </section>

  {altriArticoli.length > 0 && (
    <section class="articles-section wrap">
      <div class="section-head">
        <div><p class="eyebrow">DALLA REDAZIONE</p><h2>Articoli</h2></div>
        <span class="section-rule" aria-hidden="true"></span>
      </div>
      <div class="news-grid news-grid--three">
        {altriArticoli.map((article) => (
          <article class="news-card">
            <div class="featured-meta"><span>{article.data.category}</span><time datetime={article.data.publishedAt.toISOString()}>{article.data.publishedAt.toLocaleDateString('it-IT')}</time><span>{article.data.readTime}</span></div>
            <h3><a href={`${base}articoli/${article.id}/`}>{article.data.title}</a></h3>
            <p>{article.data.excerpt}</p>
            <a class="read-link" href={`${base}articoli/${article.id}/`}>Continua →</a>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="next-section" id="prossima">
    <div class="wrap next-grid">
      <div>
        <p class="eyebrow light">PROSSIMA USCITA</p>
        <h2>{editorial.nextIssue.label}<br /><small>{editorial.nextIssue.title}</small></h2>
      </div>
      <div class="next-box">
        <span class="next-box__label">NOTIFIER</span>
        <button type="button" class="button button--locked" disabled aria-disabled="true">Avvisami</button>
        <p>Il pulsante verrà attivato quando il sistema di notifica sarà pronto.</p>
      </div>
    </div>
  </section>

  <section class="social-contact-section wrap" id="social">
    <div class="social-grid">
      <div class="social-block">
        <p class="eyebrow">SOCIAL</p>
        <h2>Seguici dove nascono i rilasci.</h2>
        <a class="social-link" href={editorial.social.instagramUsUrl} rel="noreferrer"><span>Instagram</span><strong>{editorial.social.instagramUs}</strong> ↗</a>
        <a class="social-link" href={editorial.social.instagramMotherUrl} rel="noreferrer"><span>Organizzazione madre</span><strong>{editorial.social.instagramMother}</strong> ↗</a>
      </div>
      <div class="contact-block" id="contatti">
        <p class="eyebrow">CONTATTI</p>
        <h2>Una collaborazione seria?</h2>
        <p>Per collaborazioni, proposte editoriali, distribuzione, segnalazioni importanti o comunicazioni che meritano una risposta, scrivi a:</p>
        <a class="contact-email" href={`mailto:${editorial.contact.email}`}>{editorial.contact.email}</a>
      </div>
    </div>
  </section>
</Layout>
