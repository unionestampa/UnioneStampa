---
import Layout from '../../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
const rows = [
  { id: 'una-cosa-commune-ott26', number: '01', title: 'Una cosa commune', category: 'Internazionale', description: 'Come loro, centocinquantacinque anni fa.' },
  { id: 'testudo-populi-ott26', number: '02', title: 'Testudo populi', category: 'Nazionale', description: 'Un fronte impenetrabile, che il potere tenta di spezzare.' },
  { id: 'fotografie-ott26', number: '03', title: 'Fotografie', category: 'Autori visivi del mese', description: 'Gli sguardi e gli autori selezionati per il numero di ottobre.' },
  { id: '04-ottobre-26', number: '04', title: '', category: '', description: '' },
  { id: 'crisi-organica-ott26', number: '05', title: 'Cultura e teoria', description: 'Dal malcontento spontaneo all’organizzazione politica.' },
  { id: 'agenda-ottobre-26', number: '06', title: 'Agenda', description: 'Attività svolte, progetti in corso e sviluppi futuri.' },
];
---
<Layout title="Piuma - Ottobre 26 — L’Unione Stampa" description="Il primo numero di Piuma, ottobre 2026: informazione, fotografia, cultura e agenda.">
  <main class="piuma-issue-page wrap">
    <a class="back-link" href={`${base}manifesti/`}>← Torna ai Manifesti</a>
    <header class="piuma-issue-header">
      <p class="eyebrow piuma-issue-blurred-label">LA PIUMA · NUMERO 01</p>
      <h1 class="piuma-issue-title">
        <img class="piuma-issue-symbol" src={`${base}images/brand/logo-piuma-rosso.png`} alt="" aria-hidden="true" />
        <span class="piuma-issue-title-text">OTTOBRE <span>26</span></span>
      </h1>
      <p class="piuma-issue-intro piuma-issue-blurred-label">Il primo numero. Sei pagine, sei sguardi sul presente.</p>
    </header>
    <div class="piuma-issue-availability" role="status" aria-live="polite">
      <strong>Disponibile a breve</strong>
      <span>Ultimi ritocchi in corso: la pagina sarà aggiornata a breve.</span>
    </div>
    <section class="piuma-issue-index piuma-issue-index--blurred" aria-label="Contenuti in preparazione">
      {rows.map((row) => (
        <div class="piuma-issue-row">
          <span class="piuma-issue-row-number">{row.number}</span>
          <span class="piuma-issue-row-main">{row.category && <span class="piuma-issue-row-category">{row.category}</span>}<strong>{row.title}</strong>{row.description && <span class="piuma-issue-row-description">{row.description}</span>}</span>
          <span class="piuma-issue-row-arrow" aria-hidden="true">↗</span>
        </div>
      ))}
    </section>
    <footer class="piuma-issue-credits piuma-issue-credits--blurred">
      <p><strong>© 2026 Unione Stampa · Unione Sparvieri</strong><br />Tutti i diritti riservati.</p>
      <p>Ideazione, direzione editoriale, redazione, ricerca, scrittura, progettazione grafica, impaginazione e preparazione per la stampa:<br /><strong>Luca Barretta Lalić</strong>.</p>
      <p>Produzione e pubblicazione: <strong>Unione Stampa · Unione Sparvieri</strong>.</p>
    </footer>
  </main>
</Layout>
